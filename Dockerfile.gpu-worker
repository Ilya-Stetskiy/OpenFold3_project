FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    OPENFOLD_PROJECT_DIR=/work/OpenFold3_project \
    OPENFOLD_REPO_DIR=/work/OpenFold3_project/openfold-3 \
    WORKER_RESULTS_DIR=/work/OpenFold3_project/.runtime/gpu_worker

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python-is-python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work/OpenFold3_project

COPY gpu_worker ./gpu_worker
COPY openfold-3 ./openfold-3

ARG INSTALL_OPENFOLD_DEPS=1
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir pydantic click PyYAML \
    && if [ "$INSTALL_OPENFOLD_DEPS" = "1" ]; then \
        python3 -m pip install --no-cache-dir -e ./openfold-3; \
    fi

ENV PYTHONPATH=/work/OpenFold3_project:/work/OpenFold3_project/openfold-3

CMD ["python3", "-m", "gpu_worker.main"]
